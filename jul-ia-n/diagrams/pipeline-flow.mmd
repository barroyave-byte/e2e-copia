%%{init: {'theme':'base','themeVariables':{'fontFamily':'Inter,Segoe UI,sans-serif','fontSize':'15px'}}}%%
flowchart TD
    START(["test-results.json<br/><i>regresión de Playwright</i>"]):::input

    A["<b>A. normalize</b><br/>extrae tests fallidos + texto del reporte<br/><i>steps/normalize.ts</i>"]:::nollm
    B["<b>B. classify</b> 🧠<br/>rootCauseCategory · teamOwner · failedStep<br/>isCredentialIssue · rootCause<br/><i>1 llamada (max_tokens alto) · chunking opt-in · MODEL_CLASSIFY</i>"]:::llm
    C["<b>C. dedup</b><br/>agrupa por signature (rootCause)<br/>1 leader / N duplicados<br/><i>steps/dedup.ts</i>"]:::nollm

    PREP["<b>prepare KB · 1 vez</b> 🔎<br/>carga KB + embeddings de entradas<br/>+ batch de query-vectors de todos los leaders<br/><i>una sola vez · sin red/disco por leader · steps/knowledge.ts</i>"]:::embed

    DUP{¿es duplicado?}:::decision
    INHERIT["hereda la decisión del leader<br/><b>0 LLM</b> → va directo al CSV"]:::skip

    GATE1{"budget cap / PR cap<br/>alcanzado?"}:::decision
    SKIP1["se registra y se omite<br/>(skipped-budget / skipped-pr-cap)"]:::skip

    subgraph LEADER["POR CADA LEADER · pool concurrente (AI_HEAL_CONCURRENCY, def. 6) — solo los leaders pagan I/O + LLM"]
        direction TB
        D["<b>D. enrich</b> (lazy)<br/>trace.zip · error-context · orderId/txId<br/>network calls · DOM · stderr<br/><i>steps/enrich.ts</i>"]:::nollm
        E["<b>E. investigate</b><br/>adaptador trace-level<br/>(ya NO pega a CloudWatch)<br/><i>steps/investigate.ts</i>"]:::nollm
        F["<b>F. KB score</b><br/>coseno en memoria vs KB precomputado<br/>→ matches + sección asesora 'prior art'<br/><i>determinístico · sin red ni disco por leader</i>"]:::nollm

        SC{"decideShortCircuit<br/>tier?"}:::decision

        G_KB["<b>G. routing — KB</b><br/>decisión sintetizada del KB<br/>(decisionFromKnowledge)<br/><b>salta el orquestador LLM</b>"]:::nollm
        G_LLM["<b>G. routing — orquestador</b> 🧠<br/>subagente · bugLocation (e2e/service)<br/>suspectedRepo · confidence · categoryOverride<br/><i>MODEL_REASONING</i>"]:::llm
        KNOWN["<b>known-issue</b> — issue externo recurrente<br/>escribe CSV (QA Review / Root cause QA)<br/>+ telemetry directo<br/><b>salta orquestador, subagente Y verify</b><br/><i>umbral propio ≥ 0.95 + categoría</i>"]:::skip

        CONF{"confidence ≥ 0.8?"}:::decision
        SKIP2["skipped-low-confidence<br/>espera triage humano"]:::skip

        SCAPPLY{"tier = apply?<br/>(trae replayableFix)"}:::decision
        H_APPLY["<b>H. subagente — apply</b><br/>buildShortCircuitProposal<br/>aplica replayableFix<br/><b>salta el subagente LLM</b>"]:::nollm

        SUBKIND{"¿subagente<br/>agéntico?"}:::decision
        H_AGENT["<b>H. subagente agéntico</b> 🧠🔁<br/>assertFixer · serviceInvestigator<br/>loop multi-turno con tools read-only<br/>read_file · grep · glob · query_cloudwatch"]:::llm
        H_SINGLE["<b>H. subagente single-shot</b> 🧠<br/>los otros 10 (selectorFixer, cardFixer,<br/>credentialsFixer, payloadFixer, …)<br/>getStructuredOutput"]:::llm

        GUARD["<b>guardas</b><br/>enforceKindRules + validateFileChanges<br/>(allowlist: tests/** · pages/** · interfaces/**)"]:::guard
        PROP["proposal.kind =<br/><b>diff</b> · <b>issue</b> · <b>enrichment_only</b>"]:::nollm
    end

    FLAGS{"--dry-run / --no-pr?"}:::decision
    SKIP3["dry-run / no-pr-flag<br/>(no abre nada)"]:::skip

    ISDIFF{"kind = diff?"}:::decision
    I["<b>I. verify</b> 🔁<br/>git worktree + corre el test <b>3×</b><br/>veredicto ready-to-pr (≥2 ok) / needs-human<br/><i>semáforo propio (AI_HEAL_VERIFY_CONCURRENCY, def. 2) · red de seguridad final · sin LLM</i>"]:::nollm
    SKIPV["skip verify<br/>(issue / enrichment_only)"]:::nollm

    J["<b>J. submit</b><br/>PR draft · Issue · nada<br/><i>steps/pr.ts</i>"]:::nollm
    OUT(["CSV (release.csv) + telemetry/runs/*.json"]):::output

    START --> A --> B --> C --> PREP --> DUP
    DUP -->|sí| INHERIT --> OUT
    DUP -->|no| GATE1
    GATE1 -->|sí| SKIP1 --> OUT
    GATE1 -->|no| D
    D --> E --> F --> SC
    SC -->|route / apply| G_KB --> CONF
    SC -->|none| G_LLM --> CONF
    SC -->|known-issue| KNOWN --> OUT
    CONF -->|no| SKIP2 --> OUT
    CONF -->|sí| SCAPPLY
    SCAPPLY -->|sí| H_APPLY --> GUARD
    SCAPPLY -->|no| SUBKIND
    SUBKIND -->|sí| H_AGENT --> GUARD
    SUBKIND -->|no| H_SINGLE --> GUARD
    GUARD --> PROP --> FLAGS
    FLAGS -->|sí| SKIP3 --> OUT
    FLAGS -->|no| ISDIFF
    ISDIFF -->|sí| I --> J
    ISDIFF -->|no| SKIPV --> J
    J --> OUT

    classDef input fill:#1e293b,stroke:#0f172a,color:#fff,font-weight:bold
    classDef output fill:#1e293b,stroke:#0f172a,color:#fff,font-weight:bold
    classDef llm fill:#fde68a,stroke:#d97706,color:#7c2d12,stroke-width:2px
    classDef embed fill:#fbcfe8,stroke:#db2777,color:#831843,stroke-width:2px
    classDef nollm fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef decision fill:#e9d5ff,stroke:#7c3aed,color:#4c1d95,font-weight:bold
    classDef skip fill:#f1f5f9,stroke:#94a3b8,color:#475569,stroke-dasharray:4 3
    classDef guard fill:#dcfce7,stroke:#16a34a,color:#14532d
