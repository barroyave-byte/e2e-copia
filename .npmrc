# One Node/npm for everyone: the Node in .nvmrc (Node 24 LTS) and the npm it bundles (npm 11), which
# is also what CI (node-version-file: .nvmrc) and the Docker image use. Different npm majors rewrite
# package-lock.json differently (npm 11 drops optional peer entries that npm 10 keeps), so mixed
# versions produce lockfile diffs nobody asked for, and a lock written by one major has broken
# `npm ci` under another before (6f3c62506).
# With engine-strict, `npm install` / `npm ci` fail fast outside package.json "engines".
engine-strict=true
