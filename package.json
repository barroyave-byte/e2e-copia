{
  "name": "pw2",
  "version": "1.0.0",
  "description": "Playwright 2",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "format-code": "prettier \"**/*.{js,ts,tsx,json,md}\" --write .",
    "all:test": "npx playwright test --project=chromium",
    "onetest": "npx playwright test ADM-T434 --headed --project=chromium",
    "pwreportlist": "npx playwright test --reporter=list",
    "pw:run:ci": "npx playwright test --grep @regression",
    "test:oregon": "NODE_ENV=oregon-regional-prod playwright test",
    "testdocker": "npx playwright test --project=only_preprod --retries 0 --trace on",
    "test:visual": "npx playwright test --project=visual-testing --grep @visual",
    "update-snapshot": "node scripts/update-visual-snapshot.js",
    "test:checkout_base": "npx playwright test --grep '@checkout_base' --project=chromium",
    "test:elements_link": "npx playwright test --grep @elements_link --project=chromium",
    "test:checkout_qsr": "npx playwright test --grep @checkout_qsr --project=chromium",
    "test:security": "npx playwright test playwright/tests/teams/admin/security --workers=2 --project=chromium",
    "compare-regressions": "npx ts-node playwright/regresiones/compare-regressions.ts",
    "filter-tests-by-team": "npx ts-node scripts/filter-tests-by-team.ts",
    "generate-test-cases": "ts-node ./scripts/jira-test-case-generator/cli.ts",
    "jul-ia-n": "ts-node -r tsconfig-paths/register jul-ia-n/index.ts",
    "ai-summarize": "npm run jul-ia-n",
    "ai-heal": "ts-node -r tsconfig-paths/register jul-ia-n/heal.ts",
    "ai-heal:eval": "npm run ai-heal:eval:install && ts-node -r tsconfig-paths/register jul-ia-n/eval/run-eval.ts",
    "ai-heal:eval:install": "npm ci --prefix jul-ia-n/eval --no-audit --no-fund",
    "ai-heal:parity": "ts-node -r tsconfig-paths/register jul-ia-n/eval/parity-test.ts",
    "ai-heal:bench": "ts-node -r tsconfig-paths/register jul-ia-n/eval/subagent-bench.ts",
    "ai-heal:kb": "ts-node -r tsconfig-paths/register jul-ia-n/eval/knowledge-search.ts",
    "ai-heal:bootstrap-cards": "ts-node -r tsconfig-paths/register jul-ia-n/tools/bootstrapCardPool.ts",
    "ai-heal:compare-release": "ts-node -r tsconfig-paths/register jul-ia-n/tools/compareReleases.ts",
    "ai-heal:metrics": "ts-node -r tsconfig-paths/register jul-ia-n/eval/resolution-metrics.ts",
    "ai-heal:test": "ts-node -r tsconfig-paths/register jul-ia-n/tests/aiHealMarker.test.ts",
    "test:dsl": "node scripts/test-dsl.js",
    "test:merchant-pool": "ts-node -r tsconfig-paths/register scripts/merchant-pool/tests/run.ts",
    "merchant-pool:provision": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/provision.ts",
    "merchant-pool:report": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/report.ts",
    "merchant-pool:eligibility": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/eligibility.ts",
    "merchant-pool:migrate": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/migrate.ts",
    "merchant-pool:canary": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/canary.ts",
    "merchant-pool:admin-session": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/admin-session.ts",
    "merchant-pool:release": "ts-node -r tsconfig-paths/register scripts/merchant-pool/cli/release.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:precommit": "node scripts/precommit-typecheck.js",
    "generate-action-types": "ts-node -r tsconfig-paths/register scripts/generate-action-types.ts",
    "typecheck:strict": "node scripts/typecheck-strict.js",
    "ai-heal:sre-smoke": "ts-node -r tsconfig-paths/register jul-ia-n/eval/sreAgentTransportSmoke.ts",
    "ai-heal:sre-preflight": "ts-node -r tsconfig-paths/register jul-ia-n/eval/sreAgentPreflight.ts",
    "list-actions": "ts-node -r tsconfig-paths/register scripts/list-actions.ts",
    "collapse-migrated-or": "ts-node -r tsconfig-paths/register scripts/collapse-migrated-or.ts --",
    "describe-actions": "ts-node -r tsconfig-paths/register scripts/describe-actions.ts --",
    "pr-review": "ts-node -r tsconfig-paths/register scripts/pr-review-agent/index.ts",
    "pr-review:local": "ts-node -r tsconfig-paths/register scripts/pr-review-agent/index.ts --base origin/develop --head HEAD --dry-run",
    "paypal:janitor": "ts-node -r tsconfig-paths/register scripts/paypal-webhook-janitor.ts",
    "pr-review:check": "ts-node -r tsconfig-paths/register scripts/pr-review-agent/reconcile.check.ts",
    "pr-review:check-worktree": "ts-node -r tsconfig-paths/register scripts/pr-review-agent/worktree.check.ts",
    "pr-review:check-team-tag": "ts-node -r tsconfig-paths/register scripts/pr-review-agent/team-tag.check.ts"
  },
  "keywords": [],
  "author": "Julian Novoa",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "npm": "^11.0.0"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.13.13",
    "axios": "^1.15.2",
    "husky": "^9.0.10",
    "js-yaml": "^5.2.1",
    "lint-staged": "^16.1.2",
    "otplib": "^13.4.0",
    "prettier": "^3.5.2",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@faker-js/faker": "^10.4.0",
    "@octokit/rest": "^22.0.1",
    "adm-zip": "^0.5.10",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.7.0",
    "glob": "^13.0.6",
    "jsonpath-plus": "^10.3.0",
    "langfuse": "^3.38.20",
    "lodash.memoize": "^4.1.2",
    "mailslurp-client": "^15.20.2",
    "openai": "^6.15.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  }
}
