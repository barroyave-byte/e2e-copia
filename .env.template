# Environment variables: develop | staging | preprod
NODE_ENV=

#Metabase credentials
METABASE_USER=
METABASE_PASSWORD=

#MailSlurp
MAILSLURP_API_KEY=

#Statsig
STATSIG_API_KEY=
STATSIG_URL=

# jul-IA-N — AI summarize (existing) and AI heal (new)
# Switch the active provider for the AI pipeline: "openai" or "anthropic".
AI_PROVIDER=openai
# Enable the OpenAI <-> Anthropic parity test (`npm run ai-heal:parity`).
# Requires BOTH keys below. Default false so it skips while only one provider is set up.
AI_PARITY_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6

# jul-IA-N heal — CloudWatch logs investigation
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# jul-IA-N heal — GitHub PR creation (Phase 1: reuses DUNA_ACTION_TOKEN)
GITHUB_TOKEN=

# jul-IA-N heal — Langfuse tracing (optional; unset = tracing is a no-op)
# Local/dev: run `docker compose up -d` in jul-ia-n/infra/langfuse, then copy
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY from that folder's own .env here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000